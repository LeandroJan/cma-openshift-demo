# Simple runtime container for pre-built Quarkus JAR
FROM registry.access.redhat.com/ubi8/openjdk-17-runtime:1.18

# Set working directory
WORKDIR /work

# Copy the pre-built Quarkus app (entire quarkus-app directory structure)
COPY target/quarkus-app/lib/ /work/lib/
COPY target/quarkus-app/*.jar /work/
COPY target/quarkus-app/app/ /work/app/
COPY target/quarkus-app/quarkus/ /work/quarkus/

# OpenShift security: Change ownership to default user (185)
USER root
RUN chown -R 185:0 /work && chmod -R g+rw /work
USER 185

# Expose port
EXPOSE 8080

# Run the application
CMD ["java", "-jar", "/work/quarkus-run.jar"]
